<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F4FB"
    tools:context=".AppointmentActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Header Bar: Back Button & Title -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#0D47A1"
                    android:contentDescription="Back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="นัดหมายออนไลน์"
                    android:textColor="#0D47A1"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- 2. Step Stepper Progress Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="4dp"
                    android:gravity="center">

                    <!-- Step 1 -->
                    <LinearLayout
                        android:id="@+id/step1Layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvStep1Num"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/circle_blue_active"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStep1Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="เลือกสัตว์เลี้ยง"
                            android:textColor="#1E88E5"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Step 2 -->
                    <LinearLayout
                        android:id="@+id/step2Layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvStep2Num"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/circle_grey_inactive"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="#78909C"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStep2Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="เลือกโรงพยาบาล"
                            android:textColor="#78909C"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Step 3 -->
                    <LinearLayout
                        android:id="@+id/step3Layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvStep3Num"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/circle_grey_inactive"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="#78909C"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStep3Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="เลือกบริการ"
                            android:textColor="#78909C"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Step 4 -->
                    <LinearLayout
                        android:id="@+id/step4Layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvStep4Num"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/circle_grey_inactive"
                            android:gravity="center"
                            android:text="4"
                            android:textColor="#78909C"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStep4Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="เลือกวันที่"
                            android:textColor="#78909C"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Step 5 -->
                    <LinearLayout
                        android:id="@+id/step5Layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvStep5Num"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/circle_grey_inactive"
                            android:gravity="center"
                            android:text="5"
                            android:textColor="#78909C"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStep5Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="ยืนยัน"
                            android:textColor="#78909C"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Section 1: เลือกสัตว์เลี้ยง -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="เลือกสัตว์เลี้ยง"
                android:textColor="#0D47A1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSelectPet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardImgPet"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/ivPetPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_pet_logo"
                            android:contentDescription="Pet Photo" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/cardImgPet"
                        android:layout_toStartOf="@id/ivChevronPet"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPetName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sania"
                                android:textColor="#0D47A1"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="♂"
                                android:textColor="#1976D2"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPetBreed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="แมว • 2 ปี 1 เดือน"
                            android:textColor="#546E7A"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivChevronPet"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="#1E88E5"
                        android:contentDescription="Select Pet" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Section 2: เลือกโรงพยาบาล -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="เลือกโรงพยาบาล"
                android:textColor="#0D47A1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSelectHospital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardImgHosp"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_pet_logo"
                            android:contentDescription="Hospital Image" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/cardImgHosp"
                        android:layout_toStartOf="@id/ivChevronHosp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHospitalName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="โรงพยาบาลสัตว์พิษณุโลก"
                            android:textColor="#0D47A1"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="2.3 กม. • เปิด 8:00 - 20:00"
                            android:textColor="#546E7A"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivChevronHosp"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#1E88E5"
                        android:contentDescription="Select Hospital" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Section 3: เลือกบริการ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="เลือกบริการ"
                android:textColor="#0D47A1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <!-- Service 1: ตรวจทั่วไป (Selected) -->
                    <LinearLayout
                        android:id="@+id/svcCheckup"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="#E3F2FD"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_stethoscope"
                            app:tint="#1E88E5"
                            android:contentDescription="Checkup" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="ตรวจทั่วไป"
                            android:textColor="#1E88E5"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Service 2: ฉีดวัคซีน -->
                    <LinearLayout
                        android:id="@+id/svcVaccine"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:background="#F5F7FA"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_vaccine"
                            app:tint="#546E7A"
                            android:contentDescription="Vaccine" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="ฉีดวัคซีน"
                            android:textColor="#37474F"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Service 3: ตรวจเลือด -->
                    <LinearLayout
                        android:id="@+id/svcBlood"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:background="#F5F7FA"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_blood_drop"
                            app:tint="#546E7A"
                            android:contentDescription="Blood Test" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="ตรวจเลือด"
                            android:textColor="#37474F"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Service 4: ผ่าตัด -->
                    <LinearLayout
                        android:id="@+id/svcSurgery"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:background="#F5F7FA"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_surgery"
                            app:tint="#546E7A"
                            android:contentDescription="Surgery" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="ผ่าตัด"
                            android:textColor="#37474F"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Service 5: อื่นๆ -->
                    <LinearLayout
                        android:id="@+id/svcOther"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="#F5F7FA"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_dots_more"
                            app:tint="#546E7A"
                            android:contentDescription="Other" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="อื่นๆ"
                            android:textColor="#37474F"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6. Section 4: เลือกวันที่ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="เลือกวันที่"
                android:textColor="#0D47A1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Month Bar -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/btnPrevMonth"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_back"
                            app:tint="#1E88E5"
                            android:contentDescription="Prev Month" />

                        <TextView
                            android:id="@+id/tvCurrentMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="ตุลาคม 2026"
                            android:textColor="#0D47A1"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/btnNextMonth"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#1E88E5"
                            android:contentDescription="Next Month" />
                    </RelativeLayout>

                    <!-- Days of Week Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="อา." android:textColor="#37474F" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="จ." android:textColor="#37474F" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="อ." android:textColor="#37474F" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="พ." android:textColor="#37474F" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="พฤ." android:textColor="#37474F" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="ศ." android:textColor="#37474F" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="ส." android:textColor="#37474F" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Calendar Grid Sample Rows -->
                    <GridLayout
                        android:id="@+id/gridCalendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7">

                        <!-- Row 1: 27..31, 1..3 -->
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="32dp" android:gravity="center" android:text="27" android:textColor="#B0BEC5" android:textSize="12sp" />
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="32dp" android:gravity="center" android:text="28" android:textColor="#B0BEC5" android:textSize="12sp" />
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="32dp" android:gravity="center" android:text="29" android:textColor="#B0BEC5" android:textSize="12sp" />
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="32dp" android:gravity="center" android:text="30" android:textColor="#B0BEC5" android:textSize="12sp" />
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="32dp" android:gravity="center" android:text="1" android:textColor="#37474F" android:textSize="12sp" />
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="32dp" android:gravity="center" android:text="2" android:textColor="#37474F" android:textSize="12sp" />
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="32dp" android:gravity="center" android:text="3" android:textColor="#37474F" android:textSize="12sp" />

                        <!-- Row 2: 4..10 -->
