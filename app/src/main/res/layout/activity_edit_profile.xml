<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F4FB"
    tools:context=".EditProfileActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Header Bar: Back Button & Title -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#0D47A1"
                    android:contentDescription="Back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="แก้ไขข้อมูลส่วนตัว"
                    android:textColor="#0D47A1"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- 2. Owner Avatar & Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Avatar + Camera Badge -->
                    <RelativeLayout
                        android:id="@+id/boxAvatar"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true">

                        <ImageView
                            android:id="@+id/ivOwnerAvatar"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_profile_placeholder"
                            android:contentDescription="Owner Avatar" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnChangeAvatar"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            app:cardCornerRadius="13dp"
                            app:cardBackgroundColor="#1E88E5"
                            app:cardElevation="2dp"
                            app:strokeColor="#FFFFFF"
                            app:strokeWidth="1dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_camera"
                                app:tint="#FFFFFF"
                                android:contentDescription="Change Photo" />
                        </com.google.android.material.card.MaterialCardView>
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/boxAvatar"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvOwnerName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ชื่อ User"
                                android:textColor="#0D47A1"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/btnQuickEditName"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_pencil"
                                app:tint="#1E88E5"
                                android:contentDescription="Edit Name" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvOwnerPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="📞 088- xxx- xxxx"
                            android:textColor="#546E7A"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvOwnerEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="✉ user@gmail.com"
                            android:textColor="#546E7A"
                            android:textSize="13sp" />
                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Section 1: ข้อมูลส่วนตัว -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ข้อมูลส่วนตัว"
                android:textColor="#0D47A1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Field 1: ชื่อ - นามสกุล -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_profile"
                            app:tint="#1E88E5"
                            android:contentDescription="Name Icon" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="ชื่อ - นามสกุล"
                            android:textColor="#0D47A1"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="20dp"
                            android:background="#ECEFF1" />

                        <EditText
                            android:id="@+id/etEditName"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="ชื่อ user"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE"
                            android:textSize="14sp"
                            android:inputType="textPersonName" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="6dp" android:background="#ECEFF1" />

                    <!-- Field 2: อีเมล -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_email"
                            app:tint="#1E88E5"
                            android:contentDescription="Email Icon" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="อีเมล"
                            android:textColor="#0D47A1"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="20dp"
                            android:background="#ECEFF1" />

                        <EditText
                            android:id="@+id/etEditEmail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="user@gmail.com"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE"
                            android:textSize="14sp"
                            android:inputType="textEmailAddress" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="6dp" android:background="#ECEFF1" />

                    <!-- Field 3: เบอร์โทรศัพท์ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_phone"
                            app:tint="#1E88E5"
                            android:contentDescription="Phone Icon" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="เบอร์โทรศัพท์"
                            android:textColor="#0D47A1"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="20dp"
                            android:background="#ECEFF1" />

                        <EditText
                            android:id="@+id/etEditPhone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="088-xxx-xxxx"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE"
                            android:textSize="14sp"
                            android:inputType="phone" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="6dp" android:background="#ECEFF1" />

                    <!-- Field 4: วันเกิด -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_cake"
                            app:tint="#1E88E5"
                            android:contentDescription="Dob Icon" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="วันเกิด"
                            android:textColor="#0D47A1"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="20dp"
                            android:background="#ECEFF1" />

                        <EditText
                            android:id="@+id/etEditDob"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="12 ม.ค. 2004"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE"
                            android:textSize="14sp"
                            android:inputType="text" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Section 2: ที่อยู่ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ที่อยู่"
                android:textColor="#0D47A1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- บ้านเลขที่ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_home_blue"
                            app:tint="#1E88E5"
                            android:contentDescription="House No" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="บ้านเลขที่"
                            android:textColor="#0D47A1"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="20dp"
                            android:background="#ECEFF1" />

                        <EditText
                            android:id="@+id/etHouseNo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="-"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE"
                            android:textSize="14sp"
                            android:inputType="text" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="6dp" android:background="#ECEFF1" />

                    <!-- หมู่ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="#1E88E5"
                            android:contentDescription="Moo" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="หมู่"
                            android:textColor="#0D47A1"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="20dp"
                            android:background="#ECEFF1" />

                        <EditText
                            android:id="@+id/etMoo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="-"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE"
                            android:textSize="14sp"
                            android:inputType="text" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="6dp" android:background="#ECEFF1" />

                    <!-- ถนน -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_road"
                            app:tint="#1E88E5"
                            android:contentDescription="Road" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="ถนน"
                            android:textColor="#0D47A1"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="20dp"
                            android:background="#ECEFF1" />

                        <EditText
                            android:id="@+id/etRoad"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="-"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE"
                            android:textSize="14sp"
                            android:inputType="text" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="6dp" android:background="#ECEFF1" />

                    <!-- ตำบล -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_building"
                            app:tint="#1E88E5"
                            android:contentDescription="Sub District" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="ตำบล"
                            android:textColor="#0D47A1"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="20dp"
                            android:background="#ECEFF1" />

                        <EditText
                            android:id="@+id/etSubDistrict"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="-"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE"
                            android:textSize="14sp"
                            android:inputType="text" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="6dp" android:background="#ECEFF1" />

                    <!-- อำเภอ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="#1E88E5"
                            android:contentDescription="District" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="อำเภอ"
                            android:textColor="#0D47A1"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="20dp"
                            android:background="#ECEFF1" />

                        <EditText
                            android:id="@+id/etDistrict"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="-"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE"
                            android:textSize="14sp"
                            android:inputType="text" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="6dp" android:background="#ECEFF1" />

                    <!-- จังหวัด -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="#1E88E5"
                            android:contentDescription="Province" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="จังหวัด"
                            android:textColor="#0D47A1"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="20dp"
                            android:background="#ECEFF1" />

                        <EditText
                            android:id="@+id/etProvince"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="-"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE"
                            android:textSize="14sp"
                            android:inputType="text" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Action Button: บันทึกการเปลี่ยนแปลง -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveChange"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:text="บันทึกการเปลี่ยนแปลง"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#1E88E5"
                app:cornerRadius="26dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>