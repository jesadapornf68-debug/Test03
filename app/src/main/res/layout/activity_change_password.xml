<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F4FB"
    tools:context=".ChangePasswordActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Header Bar: Back Button & Title -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#0D47A1"
                    android:contentDescription="Back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="เปลี่ยนรหัสผ่าน"
                    android:textColor="#0D47A1"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- 2. Form Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Field 1: รหัสผ่านปัจจุบัน -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="รหัสผ่านปัจจุบัน"
                        android:textColor="#0D47A1"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardElevation="0dp"
                        app:strokeColor="#C5D8E8"
                        app:strokeWidth="1dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:id="@+id/ivLockCurr"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_lock"
                                app:tint="#1E88E5"
                                android:contentDescription="Lock" />

                            <ImageView
                                android:id="@+id/btnToggleCurrent"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_eye_off"
                                app:tint="#90A4AE"
                                android:contentDescription="Toggle Password"
                                android:clickable="true"
                                android:focusable="true" />

                            <EditText
                                android:id="@+id/etCurrentPassword"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_toEndOf="@id/ivLockCurr"
                                android:layout_toStartOf="@id/btnToggleCurrent"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="10dp"
                                android:background="@null"
                                android:hint="กรอกรหัสผ่านปัจจุบัน"
                                android:textColor="#263238"
                                android:textColorHint="#B0BEC5"
                                android:textSize="14sp"
                                android:inputType="textPassword" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Field 2: รหัสผ่านใหม่ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="รหัสผ่านใหม่"
                        android:textColor="#0D47A1"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardElevation="0dp"
                        app:strokeColor="#C5D8E8"
                        app:strokeWidth="1dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:id="@+id/ivLockNew"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_lock"
                                app:tint="#1E88E5"
                                android:contentDescription="Lock" />

                            <ImageView
                                android:id="@+id/btnToggleNew"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_eye_off"
                                app:tint="#90A4AE"
                                android:contentDescription="Toggle Password"
                                android:clickable="true"
                                android:focusable="true" />

                            <EditText
                                android:id="@+id/etNewPassword"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_toEndOf="@id/ivLockNew"
                                android:layout_toStartOf="@id/btnToggleNew"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="10dp"
                                android:background="@null"
                                android:hint="กรอกรหัสผ่านใหม่"
                                android:textColor="#263238"
                                android:textColorHint="#B0BEC5"
                                android:textSize="14sp"
                                android:inputType="textPassword" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Field 3: ยืนยันรหัสผ่านใหม่ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="ยืนยันรหัสผ่านใหม่"
                        android:textColor="#0D47A1"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardElevation="0dp"
                        app:strokeColor="#C5D8E8"
                        app:strokeWidth="1dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:id="@+id/ivLockConfirm"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_lock"
                                app:tint="#1E88E5"
                                android:contentDescription="Lock" />

                            <ImageView
                                android:id="@+id/btnToggleConfirm"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_eye_off"
                                app:tint="#90A4AE"
                                android:contentDescription="Toggle Password"
                                android:clickable="true"
                                android:focusable="true" />

                            <EditText
                                android:id="@+id/etConfirmPassword"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_toEndOf="@id/ivLockConfirm"
                                android:layout_toStartOf="@id/btnToggleConfirm"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="10dp"
                                android:background="@null"
                                android:hint="ยืนยันรหัสผ่านใหม่"
                                android:textColor="#263238"
                                android:textColorHint="#B0BEC5"
                                android:textSize="14sp"
                                android:inputType="textPassword" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Criteria Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E3F2FD"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="เงื่อนไขรหัสผ่าน"
                        android:textColor="#0D47A1"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="✔  อย่างน้อย 8 ตัวอักษร"
                        android:textColor="#1E88E5"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="✔  มีตัวอักษรพิมพ์ใหญ่ (A-Z) และพิมพ์เล็ก (a-z)"
                        android:textColor="#1E88E5"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="✔  มีตัวเลข (0-9)"
                        android:textColor="#1E88E5"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✔  มีอักขระพิเศษ เช่น !@#$%^&amp;*"
                        android:textColor="#1E88E5"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Submit Change Password Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitChangePassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:text="🔒 เปลี่ยนรหัสผ่าน"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#1E88E5"
                app:cornerRadius="26dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>